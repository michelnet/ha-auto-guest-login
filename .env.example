# Reachable from inside the container. On Docker Desktop, use
# http://host.docker.internal:8123 when Home Assistant runs on the host.
HA_INTERNAL_URL=http://host.docker.internal:8123

# Reachable from your guests' browsers. Omit when it is identical to HA_INTERNAL_URL.
HA_PUBLIC_URL=http://homeassistant.local:8123

# URL guests use to reach this service. Recommended for correct admin links and QR codes.
APP_PUBLIC_URL=http://docker-host.local:8675

GUEST_USERNAME=guest
GUEST_PASSWORD=change-me
GUEST_DASHBOARD_PATH=lovelace/default_view

# Optional: enables the ha_auto_login_guest_logged_in event.
# HA_TOKEN=replace-with-a-long-lived-access-token

WELCOME_SCREEN_DELAY_MS=3000
WELCOME_SCREEN_MAIN_TEXT=Thanks for Visiting
WELCOME_SCREEN_SECONDARY_TEXT=Redirecting to Home Assistant...
